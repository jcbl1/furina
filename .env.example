# Copy to .env and fill in local values. Never commit real secrets.
DB_URL=jdbc:mysql://localhost:3306/furina?useSSL=false&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=utf8&serverTimezone=GMT%2B8
DB_USERNAME=root
DB_PASSWORD=my-secret-pw
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173
FILE_STORAGE_ROOT=./src/main/resources/static/files

OPENAI_BASE_URL=https://api.bianxie.ai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
ELASTICSEARCH_INDEX=spring-ai-document-index2
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

SPRING_PROFILES_ACTIVE=dev
